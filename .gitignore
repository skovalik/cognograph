# Dependencies
node_modules/

# Local shortcuts and personal files
*.bat
*.lnk
workplace saves/
shader*.png
patent-*.png
p1-fig*.png

# Build output: dist/* contents are gitignored, but signed-build
# manifests under dist/wave-5/ and dist/attestations/ carry verifiable
# attestations and are re-included explicitly.
dist/*
!dist/wave-5/
!dist/attestations/
dist-electron/
dist-web/
out/
release/

# Signed build artifacts: manifests + Ed25519 signatures (verifiable
# by anyone with dist/attestations/cosign.pub). The private signing
# key is excluded explicitly.
dist/attestations/cosign.key

# Electron
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Phase-close per-step idempotency markers (transient run state; see plan D.H)

# Phase C generator venv (per-machine, platform-specific; see plan §C1)

# Environment
.env
.env.*
orchestrator/.env

# Secrets
.keys/
.supabase/keys.txt
.resend/

# TypeScript
*.tsbuildinfo

# Testing
coverage/
test-results/
!test-results/.gitkeep

# Misc
*.bak
*.tmp

# Windows artifacts
nul

# Claude temporary files
tmpclaude-*
.claude/

# Temporary utility scripts
test.txt
update-workspace.js
e2e/test-results/

# Claude Code activity bridge (ephemeral session data)
# The JSONL events file is runtime data that must not be committed.
# The hook script (.cognograph-activity/hook.mjs) IS tracked in git.
.cognograph-activity/events.jsonl
.env.test
.worktrees/
%SystemDrive%/
supabase/.temp/

# Secrets vault
.secrets/

# Generated config (written by claudeConfigWriter per terminal session)
.cognograph-context.md
.mcp.json

# Test screenshots and temp artifacts
test-*.png
screenshot-*.png
*_b64.txt
screenshot-test.mjs
